# Never put database or SMTP credentials in VITE_* variables.
NODE_ENV=development
PORT=5000
# file uses the versioned project archive and needs no credentials.
DATA_SOURCE=file
# Only required when DATA_SOURCE=mongodb:
# MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Set the actual public origin at BUILD time for canonical, OG image and sitemap:
# SITE_URL=https://your-domain.example
