{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Daniel Badura — DevOps / Platform Engineer portfolio",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node backend/server.js",
    "server": "node --watch backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix frontend",
    "heroku-postbuild": "npm ci --prefix frontend --include=dev && npm run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --prefix frontend",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/optimize-assets.mjs",
    "data:feed": "node backend/seeder.js",
    "data:remove": "node backend/seeder.js -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel-Badura/PortfolioV2.git"
  },
  "author": "Daniel Badura",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^4.22.3",
    "mongoose": "^8.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
